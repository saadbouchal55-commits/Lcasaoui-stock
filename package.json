{
  "name": "lcasaoui-stock-tool",
  "version": "1.0.0",
  "description": "L'Casaoui — restaurant stock, waste-detection and auto-ordering tool (Emergency v1)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "prisma": {
    "schema": "db/schema.prisma",
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node prisma/seed.js",
    "test": "node --test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "job:nightly": "node jobs/nightly.js",
    "build:frontend": "npm --prefix frontend install && npm --prefix frontend run build"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
