# ── Database ────────────────────────────────────────────────────────────────
# MySQL now (Hostinger Business). Switch db provider in db/schema.prisma to
# "postgresql" and change this URL when moving to the VPS.
DATABASE_URL="mysql://user:password@localhost:3306/lcasaoui"

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Session signing secret — set to a long random string in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# ── Security ──────────────────────────────────────────────────────────────────
# Login rate limit (per IP + username) and session lifetime.
LOGIN_WINDOW_MS=900000        # 15 minutes
LOGIN_MAX_ATTEMPTS=10
SESSION_TTL_MS=43200000       # 12 hours

# ── First-run admin (Direction) ──────────────────────────────────────────────
# Used by the seed script to create the initial Direction account if no users
# exist. Change the password immediately after first login.
SEED_ADMIN_USERNAME="direction"
SEED_ADMIN_PASSWORD="change-me"

# ── Auto-order engine tuning (see src/config.js for full list) ────────────────
# Order at night -> produced next morning -> delivered midday. One delivery
# covers ~1 day; the morning runs on the previous night's leftover.
COVERAGE_DAYS=1
MORNING_FRACTION=0.25
# Number of recent days averaged for daily-item consumption.
LEARNING_WINDOW_DAYS=14
